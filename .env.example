# droplet-template-shipstation (Next.js) — example environment.
#
# Copy to .env and fill in real values. Never commit .env.
#
# The Rails app's own example lives in .env.local.example and is unchanged.
# Both apps read the same DATABASE_URL.

# ============================================================================
# REQUIRED
# ============================================================================

# The droplet's database. This is the SAME database the Rails app uses: the
# Prisma schema maps every model back to the existing Rails tables and columns.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/droplet_template_development

# Active Record Encryption keys — the SAME three the Rails app reads in
# config/application.rb. `integration_settings.settings` holds each company's
# ShipStation credentials inside Active Record's encryption envelope, and this
# app reads and writes that exact format so both apps can run against the row.
# Get these wrong and every company's integration silently reads as unconfigured.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Bearer token for the two scheduled-job endpoints, which replace Solid Queue's
# recurring tasks:
#   POST /api/jobs/sync-tracking        (every 30 minutes)
#   POST /api/jobs/release-held-orders  (every 5 minutes)
# Unset means those endpoints refuse every request — there is no open default.
CRON_SECRET=

# Signing key for the Auth.js session cookie. Generate with:
#   openssl rand -base64 32
# Changing it signs everyone out; it is not related to any Fluid credential.
AUTH_SECRET=

# Public URL of this droplet. Used to build the webhook and callback URLs sent
# to Fluid at registration, and — critically — to tell OUR callback
# registrations apart from those of other droplets installed for the same
# company. Locally this is your ngrok URL; in production the Cloud Run URL.
#
# Matched EXACTLY: a trailing slash or an http/https mismatch adopts nothing.
FLUID_DROPLET_URL=http://localhost:3000

# The shared token Fluid signs droplet.installed / droplet.uninstalled with.
# It is the same value as the `auth_token` in the `fluid_webhook` settings row,
# and it is accepted ONLY for those two events.
FLUID_WEBHOOK_AUTH_TOKEN=

# ============================================================================
# OPTIONAL
# ============================================================================

# Base URL for outbound calls to the Fluid API. Defaults to
# https://api.fluid.app. The `fluid_api` settings row overrides this for calls
# made through the admin UI; this is the fallback for calls made with a
# company's own token.
# FLUID_API_URL=https://api.fluid.app

# This droplet's uuid, as issued by Fluid. Install events naming a different
# droplet are ignored. Normally read from the `droplet` settings row (which
# `Create Droplet` fills in); set this only if you need to guard before that
# row exists.
# DROPLET_UUID=

# ============================================================================
# SCRIPTS ONLY — not read by the running app
# ============================================================================

# Used by `pnpm setup:create-admin` to create the first admin user.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
